# Local package for Platinum Neue (Qt style + KWin decoration), built from ../src.
# Build and install:  cd pkg && makepkg -si      Remove:  sudo pacman -R platinum-neue
pkgname=platinum-neue
pkgver=0.1.0
pkgrel=1
pkgdesc="Platinum Neue: Qt style, KWin decoration (fork of Breeze 6.8.2), Plasma theme, GTK theme, colour schemes, EB Garamond"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(qt6-base qt6-declarative qt6-svg kdecoration frameworkintegration kcmutils
         kcolorscheme kconfig kcoreaddons kguiaddons ki18n kiconthemes kwindowsystem
         breeze-gtk)  # the GTK theme builds on Breeze GTK
makedepends=(cmake extra-cmake-modules ninja)
_fonts=https://github.com/google/fonts/raw/main/ofl/ebgaramond
source=("EBGaramond.ttf::$_fonts/EBGaramond%5Bwght%5D.ttf" "EBGaramond-OFL.txt::$_fonts/OFL.txt")
sha256sums=('ef9512f92f6d579e5dc75af59a5a4b1b8b47d2eda89e00b954d44520e5369027'
            '0985066662eb755ed3683ae5482a81a9195b49ce3f7e165cc2388b3dbece7dd7')

build() {
  cmake -S "$startdir/../src" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$startdir/../color-schemes/PlatinumNeueLight.colors" "$pkgdir/usr/share/color-schemes/PlatinumNeueLight.colors"
  install -Dm644 "$startdir/../color-schemes/PlatinumNeueDark.colors" "$pkgdir/usr/share/color-schemes/PlatinumNeueDark.colors"
  # Plasma desktop themes (generated by tools/gen_plasma.py)
  install -d "$pkgdir/usr/share/plasma/desktoptheme"
  cp -r "$startdir/../plasma/desktoptheme/platinum-neue-light" "$startdir/../plasma/desktoptheme/platinum-neue-dark" \
    "$pkgdir/usr/share/plasma/desktoptheme/"
  # global themes (System Settings > Colors & Themes > Global Theme)
  install -d "$pkgdir/usr/share/plasma/look-and-feel"
  cp -r "$startdir/../plasma/look-and-feel/org.platinumneue.light.desktop" "$startdir/../plasma/look-and-feel/org.platinumneue.dark.desktop" \
    "$pkgdir/usr/share/plasma/look-and-feel/"
  # GTK 3/4 themes (generated by tools/gen_gtk.py)
  install -d "$pkgdir/usr/share/themes"
  cp -r "$startdir/../gtk/Platinum-Neue" "$startdir/../gtk/Platinum-Neue-Dark" "$pkgdir/usr/share/themes/"
  # EB Garamond (OFL), used by the panel clock
  install -Dm644 "$srcdir/EBGaramond.ttf" "$pkgdir/usr/share/fonts/platinum-neue/EBGaramond.ttf"
  install -Dm644 "$srcdir/EBGaramond-OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/EBGaramond-OFL.txt"
}
